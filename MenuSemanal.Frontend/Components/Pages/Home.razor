@page "/"

<PageTitle>Inicio</PageTitle>

<style>
    .planifica-title::before,
    .planifica-title::after {
        content: none !important;
        display: none !important;
    }

    .planifica-home {
        position: relative;
        min-height: calc(100vh - 70px);
        margin: -24px;
        padding: 35px 45px 50px;
        overflow: hidden;
        background: radial-gradient(circle at 5% 5%, rgba(164, 220, 126, .45) 0, rgba(164, 220, 126, 0) 25%), radial-gradient(circle at 95% 90%, rgba(137, 204, 96, .35) 0, rgba(137, 204, 96, 0) 30%), linear-gradient(135deg, #f8fff3 0%, #f1fbe8 50%, #e8f6da 100%);
    }

        .planifica-home::before {
            content: "";
            position: absolute;
            width: 320px;
            height: 320px;
            right: -150px;
            top: -150px;
            border-radius: 50%;
            background: rgba(123, 190, 79, .12);
            border: 1px solid rgba(85, 150, 50, .12);
        }

        .planifica-home::after {
            content: "";
            position: absolute;
            width: 330px;
            height: 330px;
            left: -190px;
            bottom: -220px;
            border-radius: 50%;
            background: rgba(126, 196, 82, .14);
        }

    .planifica-content {
        position: relative;
        z-index: 2;
        max-width: 950px;
        margin: 0 auto;
    }

    .planifica-header {
        margin-bottom: 25px;
    }

    .planifica-title {
        margin: 0;
        color: #123d25;
        font-size: 40px;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -1px;
    }

    .planifica-description {
        max-width: 680px;
        margin: 10px 0 0;
        color: #5f6d63;
        font-size: 15px;
        line-height: 1.6;
    }

    .planifica-line {
        width: 95px;
        height: 4px;
        margin-top: 18px;
        border-radius: 20px;
        background: linear-gradient(90deg, #2f8e32, #77c74e);
    }

    .planifica-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .planifica-card {
        position: relative;
        min-height: 225px;
        padding: 25px;
        display: flex;
        flex-direction: column;
        background: rgba(255, 255, 255, .96);
        border: 1px solid rgba(46, 105, 44, .10);
        border-radius: 20px;
        box-shadow: 0 10px 27px rgba(50, 85, 42, .09);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .planifica-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 17px 38px rgba(50, 85, 42, .16);
        }

    .planifica-card-top {
        display: flex;
        align-items: center;
        gap: 17px;
        margin-bottom: 14px;
    }

    .planifica-icon {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: linear-gradient(145deg, #eff9e6, #dcefc9);
    }

        .planifica-icon svg {
            width: 30px;
            height: 30px;
            stroke: #318d32;
            stroke-width: 1.8;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .planifica-card-title {
        margin: 0;
        color: #123d25;
        font-size: 21px;
        font-weight: 750;
    }

    .planifica-card-text {
        max-width: 390px;
        margin: 0 0 17px;
        color: #657168;
        font-size: 13.5px;
        line-height: 1.55;
    }

    .planifica-button {
        margin-top: auto;
        width: fit-content;
        display: inline-flex;
        align-items: center;
        gap: 13px;
        padding: 9px 16px;
        background: linear-gradient(135deg, #278b2c, #45ad32);
        color: white !important;
        text-decoration: none !important;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 5px 13px rgba(42, 139, 46, .18);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .planifica-button:hover {
            color: white !important;
            transform: translateY(-2px);
            box-shadow: 0 9px 18px rgba(42, 139, 46, .27);
        }

    .planifica-arrow {
        font-size: 17px;
        transition: transform .2s ease;
    }

    .planifica-button:hover .planifica-arrow {
        transform: translateX(4px);
    }

    .dots {
        position: absolute;
        display: grid;
        grid-template-columns: repeat(4, 4px);
        gap: 9px;
        z-index: 1;
    }

        .dots span {
            width: 4px;
            height: 4px;
            background: rgba(77, 145, 50, .22);
            border-radius: 50%;
        }

    .dots-top {
        top: 35px;
        right: 50px;
    }

    .dots-bottom {
        bottom: 35px;
        right: 60px;
    }

    @@media (max-width: 900px) {
        .planifica-home {
            padding: 35px 25px;
        }

        .planifica-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .planifica-home {
            margin: -16px;
            padding: 28px 18px;
        }

        .planifica-title {
            font-size: 33px;
        }

        .planifica-description {
            font-size: 14px;
        }

        .planifica-card {
            min-height: 215px;
            padding: 22px;
        }
    }
</style>

<div class="planifica-home">

    <div class="dots dots-top">
        @for (int i = 0; i < 12; i++)
        {
            <span></span>
        }
    </div>

    <div class="dots dots-bottom">
        @for (int i = 0; i < 12; i++)
        {
            <span></span>
        }
    </div>

    <div class="planifica-content">

        <div class="planifica-header">

            <h1 class="planifica-title">
                PlanificaPro
            </h1>

            <p class="planifica-description">
                Organiza tus menús semanales, comidas, ingredientes y lista de compras desde un solo lugar.
            </p>

            <div class="planifica-line"></div>

        </div>

        <div class="planifica-grid">

            <div class="planifica-card">

                <div class="planifica-card-top">

                    <div class="planifica-icon">
                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                            <line x1="16" y1="3" x2="16" y2="7"></line>
                            <line x1="8" y1="3" x2="8" y2="7"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                            <line x1="8" y1="14" x2="8" y2="14"></line>
                            <line x1="12" y1="14" x2="12" y2="14"></line>
                            <line x1="16" y1="14" x2="16" y2="14"></line>
                        </svg>
                    </div>

                    <h2 class="planifica-card-title">
                        Menús Semanales
                    </h2>

                </div>

                <p class="planifica-card-text">
                    Crea y administra tus menús semanales de manera organizada.
                </p>

                <a href="/menus-semanales" class="planifica-button">
                    Gestionar Menús
                    <span class="planifica-arrow">→</span>
                </a>

            </div>

            <div class="planifica-card">

                <div class="planifica-card-top">

                    <div class="planifica-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M4 19h16"></path>
                            <path d="M5 17h14"></path>
                            <path d="M6 17a6 6 0 0 1 12 0"></path>
                            <path d="M12 8V6"></path>
                            <path d="M10.5 6h3"></path>
                        </svg>
                    </div>

                    <h2 class="planifica-card-title">
                        Comidas
                    </h2>

                </div>

                <p class="planifica-card-text">
                    Explora, agrega y administra las comidas disponibles para tus menús.
                </p>

                <a href="/comidas" class="planifica-button">
                    Gestionar Comidas
                    <span class="planifica-arrow">→</span>
                </a>

            </div>

            <div class="planifica-card">

                <div class="planifica-card-top">

                    <div class="planifica-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 21c4-3 7-7 7-12a7 7 0 0 0-14 0c0 5 3 9 7 12z"></path>
                            <path d="M9 10c2.5 0 4.5-2 5-5"></path>
                            <path d="M9 10c0 3 1 5 3 7"></path>
                        </svg>
                    </div>

                    <h2 class="planifica-card-title">
                        Ingredientes
                    </h2>

                </div>

                <p class="planifica-card-text">
                    Registra los ingredientes, cantidades y unidades de medida de cada comida.
                </p>

                <a href="/ingredientes" class="planifica-button">
                    Gestionar Ingredientes
                    <span class="planifica-arrow">→</span>
                </a>

            </div>

            <div class="planifica-card">

                <div class="planifica-card-top">

                    <div class="planifica-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M3 5h2l2.2 9.5a2 2 0 0 0 2 1.5h7.7a2 2 0 0 0 2-1.6L20 8H6"></path>
                            <circle cx="10" cy="20" r="1"></circle>
                            <circle cx="18" cy="20" r="1"></circle>
                            <path d="M10 11h6"></path>
                        </svg>
                    </div>

                    <h2 class="planifica-card-title">
                        Lista de Compras
                    </h2>

                </div>

                <p class="planifica-card-text">
                    Organiza los productos que necesitas y controla cuáles ya fueron comprados.
                </p>

                <a href="/lista-compras" class="planifica-button">
                    Gestionar Compras
                    <span class="planifica-arrow">→</span>
                </a>

            </div>

        </div>

    </div>

</div>