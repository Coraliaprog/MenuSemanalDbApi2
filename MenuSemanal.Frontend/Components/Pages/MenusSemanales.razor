@page "/menus-semanales"

@using MenuSemanal.Frontend.Models
@using MenuSemanal.Frontend.Services

@inject MenuSemanalService MenuService

<PageTitle>Menús Semanales</PageTitle>

<div class="page-header">

    <div>

        <h1>Menús Semanales</h1>

        <p>
            Crea y administra la planificación de cada semana.
        </p>

    </div>

    <button class="btn btn-success"
            @onclick="Nuevo">

        + Nuevo menú

    </button>

</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @claseMensaje">

        @mensaje

    </div>
}

<div class="row g-4">

    <div class="col-lg-4">

        <div class="card module-card">

            <div class="card-body">

                <h4>

                    @(modelo.Id == 0
                        ? "Registrar menú"
                        : "Editar menú")

                </h4>

                <EditForm Model="modelo"
                          OnValidSubmit="GuardarAsync">

                    <DataAnnotationsValidator />

                    <ValidationSummary class="text-danger" />

                    <div class="mb-3">

                        <label class="form-label">
                            Nombre
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="modelo.Nombre" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Fecha de inicio
                        </label>

                        <InputDate class="form-control"
                                   @bind-Value="modelo.FechaInicio" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Fecha de fin
                        </label>

                        <InputDate class="form-control"
                                   @bind-Value="modelo.FechaFin" />

                    </div>

                    <div class="d-flex gap-2">

                        <button class="btn btn-success"
                                type="submit"
                                disabled="@guardando">

                            @(guardando
                                ? "Guardando..."
                                : "Guardar")

                        </button>

                        <button class="btn btn-outline-secondary"
                                type="button"
                                @onclick="Nuevo">

                            Limpiar

                        </button>

                    </div>

                </EditForm>

            </div>

        </div>

    </div>

    <div class="col-lg-8">

        <div class="card module-card">

            <div class="card-body">

                @if (cargando)
                {
                    <p>Cargando menús semanales...</p>
                }
                else if (menus.Count == 0)
                {
                    <div class="empty-state">

                        No hay menús semanales registrados todavía.

                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>

                                <tr>

                                    <th>Nombre</th>

                                    <th>Fecha de inicio</th>

                                    <th>Fecha de fin</th>

                                    <th>Duración</th>

                                    <th class="text-end">
                                        Acciones
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var menu in menus)
                                {
                                    <tr>

                                        <td>

                                            <strong>
                                                @menu.Nombre
                                            </strong>

                                        </td>

                                        <td>
                                            @menu.FechaInicio.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            @menu.FechaFin.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>

                                            @CalcularDias(menu)

                                            @(CalcularDias(menu) == 1
                                                ? "día"
                                                : "días")

                                        </td>

                                        <td class="text-end">

                                            <button class="btn btn-sm btn-outline-primary me-2"
                                                    @onclick="() => Editar(menu)">

                                                Editar

                                            </button>

                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => EliminarAsync(menu.Id)">

                                                Eliminar

                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

    </div>

</div>

@code {

    private List<MenuSemanalModel> menus = [];

    private MenuSemanalModel modelo = NuevoModelo();

    private bool cargando = true;

    private bool guardando;

    private string mensaje = string.Empty;

    private string claseMensaje = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CargarAsync();
        }
        catch (Exception ex)
        {
            MostrarError(ex);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarAsync()
    {
        menus =
            await MenuService.ObtenerTodosAsync();

        menus = menus
            .OrderByDescending(menu => menu.FechaInicio)
            .ToList();
    }

    private async Task GuardarAsync()
    {
        try
        {
            mensaje = string.Empty;

            if (modelo.FechaFin < modelo.FechaInicio)
            {
                mensaje =
                    "La fecha de fin no puede ser anterior a la fecha de inicio.";

                claseMensaje =
                    "alert-danger";

                return;
            }

            guardando = true;

            if (modelo.Id == 0)
            {
                await MenuService.CrearAsync(modelo);
            }
            else
            {
                await MenuService.ActualizarAsync(modelo);
            }

            mensaje =
                "Menú semanal guardado correctamente.";

            claseMensaje =
                "alert-success";

            Nuevo();

            await CargarAsync();
        }
        catch (Exception ex)
        {
            MostrarError(ex);
        }
        finally
        {
            guardando = false;
        }
    }

    private void Editar(MenuSemanalModel menu)
    {
        modelo = new MenuSemanalModel
        {
            Id = menu.Id,
            Nombre = menu.Nombre,
            FechaInicio = menu.FechaInicio,
            FechaFin = menu.FechaFin
        };

        mensaje = string.Empty;
    }

    private async Task EliminarAsync(int id)
    {
        try
        {
            await MenuService.EliminarAsync(id);

            mensaje =
                "Menú semanal eliminado correctamente.";

            claseMensaje =
                "alert-success";

            if (modelo.Id == id)
            {
                Nuevo();
            }

            await CargarAsync();
        }
        catch (Exception ex)
        {
            MostrarError(ex);
        }
    }

    private void Nuevo()
    {
        modelo = NuevoModelo();
    }

    private static MenuSemanalModel NuevoModelo()
    {
        return new MenuSemanalModel
        {
            FechaInicio = DateTime.Today,
            FechaFin = DateTime.Today.AddDays(6)
        };
    }

    private static int CalcularDias(MenuSemanalModel menu)
    {
        return Math.Max(
            1,
            (menu.FechaFin.Date - menu.FechaInicio.Date).Days + 1);
    }

    private void MostrarError(Exception ex)
    {
        mensaje =
            $"No se pudo completar la operación. {ex.Message}";

        claseMensaje =
            "alert-danger";
    }
}